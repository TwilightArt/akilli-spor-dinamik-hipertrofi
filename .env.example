# ==============================================================================
# Akıllı Spor & Dinamik Hipertrofi Platformu (v2.1)
# Production Environment Configuration
# ==============================================================================

# App environment: 'local' shows dev-only helpers (e.g. password reset link on screen).
# Leave as 'production' on the live server.
APP_ENV=production
APP_URL=https://example.com
MAIL_FROM=no-reply@example.com

# Database Connection (cPanel MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hipertrofi_platform
DB_USER=hipertrofi_user
DB_PASS=GUCLU_BIR_VERITABANI_PAROLASI_GIRIN

# Google Gemini API (Only for weekly workout skeletons)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# Cron Security Secret (optional token for HTTP-based cron triggers)
CRON_SECRET_KEY=BURAYA_GIZLI_BIR_CRON_ANAHTARI_YAZIN
